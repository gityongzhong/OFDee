{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFDee",
  "version": "1.2.0",
  "identifier": "com.hyz.ofdviewer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OFDee v1.2.0",
        "width": 1240,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#14161A",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
